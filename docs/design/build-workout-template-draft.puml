@startuml
title Use case #2 (part 1): Build a template draft
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
hide circle
hide empty members
package "Frameworks and drivers" #FFF1DB {
    class TemplateEditorView <<Swing>>
    class ExerciseSearchView <<shared team view>>
}
package "Interface adapters" #F0EAFE {
    class EditTemplateDraftController
    class EditTemplateDraftPresenter
    class TemplateEditorViewModel {
        - draft : WorkoutTemplateDraft
        + getDraft() : WorkoutTemplateDraft
    }
    class SaveTemplateController <<part 2>> {
        + save(draft : WorkoutTemplateDraft) : void
    }
}
package "Use cases" #E4F0FF {
    interface EditTemplateDraftInputBoundary <<interface>> {
        + rename(draft : WorkoutTemplateDraft, name : String) : void
        + addExercise(draft : WorkoutTemplateDraft, exercise : Exercise) : void
        + removeExercise(draft : WorkoutTemplateDraft, rowId : UUID) : void
        + addSet(draft : WorkoutTemplateDraft, rowId : UUID) : void
        + updateSet(draft : WorkoutTemplateDraft, rowId : UUID, setIndex : int, values : DraftSet) : void
        + removeSet(draft : WorkoutTemplateDraft, rowId : UUID, setIndex : int) : void
    }
    class EditTemplateDraftInteractor
    interface EditTemplateDraftOutputBoundary <<interface>> {
        + presentDraft(updatedDraft : WorkoutTemplateDraft) : void
        + presentFailure(message : String) : void
    }
}
!$showSaved = 0
!$showDraft = 1
!include shared/template-models.iuml

TemplateEditorView --> ExerciseSearchView : uses shared exercise picker
TemplateEditorView --> EditTemplateDraftController : forwards edits
TemplateEditorView --> TemplateEditorViewModel : observes
TemplateEditorView --> SaveTemplateController : hands off draft on Save
EditTemplateDraftController --> TemplateEditorViewModel : reads current draft
EditTemplateDraftController --> EditTemplateDraftInputBoundary : sends draft and edit
EditTemplateDraftInteractor ..|> EditTemplateDraftInputBoundary
EditTemplateDraftInteractor --> EditTemplateDraftOutputBoundary : reports result
EditTemplateDraftPresenter ..|> EditTemplateDraftOutputBoundary
EditTemplateDraftPresenter --> TemplateEditorViewModel : replaces draft
EditTemplateDraftOutputBoundary ..> WorkoutTemplateDraft
@enduml
