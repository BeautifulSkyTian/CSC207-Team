' Shared declarations keep all template diagrams consistent.
' Exercise refers to the team's existing class.
package "Shared domain models" #E6F4E9 {
    class Exercise <<shared team class>> {
        + getName() : String
    }
!if $showSaved
    class Template <<entity>> {
        - templateId : int
        - templateName : String
        - groups : List<ExerciseSetGroup>
        + getTemplateId() : int
        + getTemplateName() : String
        + getGroups() : List<ExerciseSetGroup>
        + getGroup(groupId : int) : ExerciseSetGroup
    }
    class ExerciseSetGroup {
        - exercise : Exercise
        - setId : int
        - weights : List<Double>
        - reps : List<Integer>
        - time : List<Integer>
        - distance : List<Integer>
        + getExercise() : Exercise
        + getSetId() : int
        + getWeight(setIndex : int) : double
        + getReps(setIndex : int) : int
        + getTime(setIndex : int) : int
        + getDistance(setIndex : int) : int
        + getWeights() : List<Double>
        + getReps() : List<Integer>
        + getTime() : List<Integer>
        + getDistance() : List<Integer>
    }
!endif
}
!if $showDraft
package "Draft data (use-case layer)" #E4F0FF {
    class WorkoutTemplateDraft <<draft data>> {
        - templateName : String
        - groups : List<DraftExerciseGroup>
        + getTemplateName() : String
        + getGroups() : List<DraftExerciseGroup>
    }
    class DraftExerciseGroup <<draft data>> {
        - rowId : UUID
        - exercise : Exercise
        - sets : List<DraftSet>
        + getRowId() : UUID
        + getExercise() : Exercise
        + getSets() : List<DraftSet>
    }
    class DraftSet <<draft data>> {
        - weightText : String
        - repsText : String
        - timeText : String
        - distanceText : String
        + getWeightText() : String
        + getRepsText() : String
        + getTimeText() : String
        + getDistanceText() : String
    }
}
!endif
!if $showSaved
Template "1" *-- "1..*" ExerciseSetGroup : ordered groups
ExerciseSetGroup --> Exercise : selected exercise
!endif
!if $showDraft
WorkoutTemplateDraft "1" *-- "0..*" DraftExerciseGroup : ordered draft groups
DraftExerciseGroup "1" *-- "0..*" DraftSet : ordered sets
DraftExerciseGroup --> Exercise : selected exercise
!endif
